rules_version = '2';
// Şema: lib/data/schema.ts · Yayınlama: npm run db:seed
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // İstemcinin değiştirebileceği alanlar (credits yalnız sunucu)
    function clientFields() { return ['settings', 'personas', 'voices', 'updatedAt']; }

    // Uygulama yapılandırması (fiyat + katalog + KIE): tek belge, oturumlu herkes okur
    match /config/app {
      allow read: if signedIn();
      allow write: if false;
    }

    // Kullanıcı: kredi + ayarlar + personalar + sesler (tek belge)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(clientFields());
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientFields())
        && request.resource.size() < 512 * 1024;
      allow delete: if false;

      // Kütüphane: parça başına belge
      match /tracks/{id} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (request.resource == null || request.resource.size() < 200 * 1024);
      }
    }

    // KIE görevleri ve söz önbelleği: yalnız sunucu
    match /tasks/{rest=**} {
      allow read, write: if false;
    }
  }
}
