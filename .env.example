# ── KIE API ──────────────────────────────────────────────
# KIE dashboard > API Keys bölümünden alın
KIE_API_KEY=YOUR_KIE_API_KEY

# KIE dashboard > Webhook Settings > HMAC Secret
KIE_WEBHOOK_HMAC_KEY=YOUR_WEBHOOK_HMAC_KEY

# ── App URL ───────────────────────────────────────────────
# Local: http://localhost:3000
# Production: https://music.yourapp.com
APP_URL=http://localhost:3000


# ── Storage (opsiyonel) ───────────────────────────────────
# KIE media dosyaları 14 gün sonra silinir.
# Kalıcı storage için S3/R2/Supabase ekleyin:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Firebase (sunucu) ────────────────────────────────────
# Firebase Console > Proje ayarları > Hizmet hesapları > "Yeni özel anahtar oluştur"
# İndirilen JSON dosyasının yolu (ya da JSON içeriği tek satır). Dosyayı ASLA git'e eklemeyin.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Opsiyonel — varsayılan: <projectId>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=rapper-fcc44.firebasestorage.app
