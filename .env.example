# ── KIE API ──────────────────────────────────────────────
# KIE dashboard > API Keys bölümünden alın
KIE_API_KEY=YOUR_KIE_API_KEY

# KIE dashboard > Webhook Settings > HMAC Secret
KIE_WEBHOOK_HMAC_KEY=YOUR_WEBHOOK_HMAC_KEY

# ── App URL ───────────────────────────────────────────────
# Local: http://localhost:3000
# Production: https://music.yourapp.com
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
# SQLite (dev). Production için PostgreSQL önerilir:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# ── Storage (opsiyonel) ───────────────────────────────────
# KIE media dosyaları 14 gün sonra silinir.
# Kalıcı storage için S3/R2/Supabase ekleyin:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
